#!/usr/bin/env bash
# Write / refresh a named dual-tool agent handoff (Cursor ↔ Claude Code, etc.).
# Switch-only — not for syncing two parallel live sessions.
#
# Usage:
#   agent-handoff \
#     --name "auth form UI" \
#     --tool cursor \
#     --ticket path/or/n/a \
#     --spec path/or/n/a \
#     --shipped "What this session completed" \
#     --left "Remaining work" \
#     --gates "none,qa" \
#     --questions "none"
#
# Writes (in the current git repo):
#   .scratch/handoffs/<slug>.md          # canonical named handoff
#   .scratch/handoffs/LATEST.md          # current switch target (copy)
#   .scratch/handoffs/<stamp>-<slug>.md  # immutable snapshot
#
# Diff check: script fills Tree + Paths (cap 40). Agent fills Alignment + Note.
# warn ≠ block — script never refuses to write.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

NAME=""
TOOL="unknown"
TICKET="n/a"
SPEC="n/a"
SHIPPED=""
LEFT=""
GATES="none"
QUESTIONS="none"
WORKTREE=""
PATH_CAP=40

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="${2:-}"; shift 2 ;;
    --tool) TOOL="${2:-unknown}"; shift 2 ;;
    --ticket) TICKET="${2:-n/a}"; shift 2 ;;
    --spec) SPEC="${2:-n/a}"; shift 2 ;;
    --shipped) SHIPPED="${2:-}"; shift 2 ;;
    --left) LEFT="${2:-}"; shift 2 ;;
    --gates) GATES="${2:-none}"; shift 2 ;;
    --questions) QUESTIONS="${2:-none}"; shift 2 ;;
    --worktree) WORKTREE="${2:-}"; shift 2 ;;
    -h|--help)
      sed -n '2,24p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$SHIPPED" ]]; then
  SHIPPED="(fill in — what this session completed)"
fi
if [[ -z "$LEFT" ]]; then
  LEFT="(fill in — remaining work)"
fi

if [[ -z "$NAME" ]]; then
  if [[ "$SHIPPED" != "(fill in — what this session completed)" ]]; then
    NAME="$SHIPPED"
  elif [[ "$LEFT" != "(fill in — remaining work)" ]]; then
    NAME="$LEFT"
  else
    echo "error: --name is required (short thread summary usable on both tools)" >&2
    exit 1
  fi
fi

SLUG="$(
  echo "$NAME" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g' \
    | cut -c1-48
)"
if [[ -z "$SLUG" || "$SLUG" == "latest" ]]; then
  echo "error: --name slugified to empty or reserved 'latest'; pick another name" >&2
  exit 1
fi

BRANCH="$(git branch --show-current 2>/dev/null || echo unknown)"
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
if [[ -z "$WORKTREE" ]]; then
  if [[ "$GIT_DIR" == *"/worktrees/"* ]] || [[ "$ROOT" == *"/worktrees/"* ]]; then
    WORKTREE="$ROOT"
  else
    WORKTREE="main checkout"
  fi
fi

WHEN="$(date '+%Y-%m-%d %H:%M')"
STAMP="$(date '+%Y-%m-%d-%H%M')"
DIR="$ROOT/.scratch/handoffs"
mkdir -p "$DIR"

DIRTY="$(git status --porcelain 2>/dev/null | head -40 || true)"

# Path set: porcelain + unstaged + staged (unique, sorted). Not last-commit-only.
PATHS_RAW="$(
  {
    git status --porcelain 2>/dev/null | sed -E 's/^...//' | sed 's/^"//;s/"$//'
    git diff --name-only 2>/dev/null
    git diff --cached --name-only 2>/dev/null
  } | sed '/^$/d' | sort -u
)"
PATH_TOTAL=0
if [[ -n "$PATHS_RAW" ]]; then
  PATH_TOTAL="$(printf '%s\n' "$PATHS_RAW" | wc -l | tr -d ' ')"
fi

if [[ "$PATH_TOTAL" -eq 0 ]]; then
  TREE_STATE="clean"
  PATHS_BLOCK="  - (none)"
else
  TREE_STATE="dirty"
  PATHS_BLOCK="$(printf '%s\n' "$PATHS_RAW" | head -n "$PATH_CAP" | sed 's/^/  - /')"
  if [[ "$PATH_TOTAL" -gt "$PATH_CAP" ]]; then
    MORE=$((PATH_TOTAL - PATH_CAP))
    PATHS_BLOCK+=$'\n'"  - …and ${MORE} more"
  fi
fi

GATES_BLOCK=""
IFS=',' read -r -a GATE_ARR <<< "$GATES"
for g in "${GATE_ARR[@]}"; do
  g="$(echo "$g" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [[ -z "$g" ]] && continue
  GATES_BLOCK+="- [x] $g"$'\n'
done
if [[ -z "$GATES_BLOCK" ]]; then
  GATES_BLOCK="- [x] none"$'\n'
fi

if [[ -z "$DIRTY" ]]; then
  DIRTY_BLOCK="(clean)"
else
  DIRTY_BLOCK="$DIRTY"
fi

NAMED="$DIR/${SLUG}.md"
LATEST="$DIR/LATEST.md"
DATED="$DIR/${STAMP}-${SLUG}.md"

export AH_WHEN="$WHEN" AH_TOOL="$TOOL" AH_BRANCH="$BRANCH" AH_WORKTREE="$WORKTREE"
export AH_TICKET="$TICKET" AH_SPEC="$SPEC" AH_SHIPPED="$SHIPPED" AH_LEFT="$LEFT"
export AH_QUESTIONS="$QUESTIONS" AH_GATES_BLOCK="$GATES_BLOCK" AH_DIRTY="$DIRTY_BLOCK"
export AH_NAME="$NAME" AH_SLUG="$SLUG"
export AH_TREE="$TREE_STATE" AH_PATHS_BLOCK="$PATHS_BLOCK"

python3 - "$NAMED" <<'PY'
import pathlib, sys, os
from string import Template

out = pathlib.Path(sys.argv[1])
env = os.environ

def g(k, default=""):
    return env.get(k, default)

body = Template(
    """# Agent handoff

## Meta

- **Name:** $AH_NAME
- **Slug:** `$AH_SLUG`
- **When:** $AH_WHEN
- **Tool (leaving):** $AH_TOOL
- **Branch:** `$AH_BRANCH`
- **Worktree:** $AH_WORKTREE
- **Ticket:** $AH_TICKET
- **Spec:** $AH_SPEC

## What shipped

- $AH_SHIPPED

## What's left

- $AH_LEFT

## Diff check

- **Tree:** $AH_TREE
- **Paths (script):**
$AH_PATHS_BLOCK
- **Alignment (agent):** (fill ok|warn)
- **Note (agent):** (fill — required if warn)

## Flags / migrations

- Flag: (fill or n/a)
- Migration: (fill or n/a)

## Ready for gates

$AH_GATES_BLOCK
## Open questions

- $AH_QUESTIONS

## Working tree (auto)

```
$AH_DIRTY
```

## Resume one-liner

> Resume handoff **$AH_NAME** (`$AH_SLUG`) from `$AH_TICKET` on branch `$AH_BRANCH`. Spec is `$AH_SPEC`. Don't reopen closed decisions.
"""
).safe_substitute(
    AH_NAME=g("AH_NAME"),
    AH_SLUG=g("AH_SLUG"),
    AH_WHEN=g("AH_WHEN"),
    AH_TOOL=g("AH_TOOL"),
    AH_BRANCH=g("AH_BRANCH"),
    AH_WORKTREE=g("AH_WORKTREE"),
    AH_TICKET=g("AH_TICKET"),
    AH_SPEC=g("AH_SPEC"),
    AH_SHIPPED=g("AH_SHIPPED"),
    AH_LEFT=g("AH_LEFT"),
    AH_TREE=g("AH_TREE"),
    AH_PATHS_BLOCK=g("AH_PATHS_BLOCK"),
    AH_GATES_BLOCK=g("AH_GATES_BLOCK"),
    AH_QUESTIONS=g("AH_QUESTIONS"),
    AH_DIRTY=g("AH_DIRTY", "(clean)"),
)
out.write_text(body, encoding="utf-8")
PY

cp "$NAMED" "$LATEST"
cp "$NAMED" "$DATED"

echo "Wrote $NAMED  (canonical — resume by name)"
echo "Wrote $LATEST (current switch target)"
echo "Wrote $DATED  (snapshot)"
echo ""
echo "Diff check: Tree=$TREE_STATE paths=$PATH_TOTAL"
if [[ "$TREE_STATE" == "clean" ]]; then
  echo "Diff check: clean tree — agent should warn if shipped claims code landed"
fi
echo "Diff check: agent must fill Alignment (ok|warn) + Note (required if warn). warn ≠ block."
echo ""
echo "Name:  $NAME"
echo "Slug:  $SLUG"
echo "Resume on the other tool:"
echo "  resume \"$NAME\"   # or: resume from handoff  (uses LATEST after a single switch)"
echo "Continue from $TICKET on branch $BRANCH. Spec is $SPEC."
